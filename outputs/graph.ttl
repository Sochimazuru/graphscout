kg:Dataset a owl:Class ;
    rdfs:comment "a named dataset or benchmark (e.g. HotpotQA)"@en ;
    rdfs:subClassOf kg:Entity,
        schema:Dataset .

kg:Task a owl:Class ;
    rdfs:comment "a problem being solved (e.g. multi-hop question answering)"@en ;
    rdfs:subClassOf kg:Entity,
        schema:DefinedTerm .

kg:Paper a owl:Class ;
    rdfs:subClassOf schema:ScholarlyArticle .

kg:evaluatedOn a owl:ObjectProperty ;
    rdfs:comment "method or paper is evaluated on a dataset"@en .

kg:proposes a owl:ObjectProperty ;
    rdfs:comment "paper or method introduces something new"@en .

kg:Method a owl:Class ;
    rdfs:comment "a technique, algorithm, framework or system (e.g. GraphRAG, beam search)"@en ;
    rdfs:subClassOf kg:Entity,
        schema:DefinedTerm .

kg:Model a owl:Class ;
    rdfs:comment "a specific named language model (e.g. Llama 3, GPT-4)"@en ;
    rdfs:subClassOf kg:Entity,
        schema:SoftwareApplication .


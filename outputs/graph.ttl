kg:extends a owl:ObjectProperty ;
    rdfs:comment "method builds on or improves another"@en .

kg:measuredBy a owl:ObjectProperty ;
    rdfs:comment "evaluation reports a metric"@en .

kg:mentions a owl:ObjectProperty .

kg:originalRelation a owl:DatatypeProperty ;
    rdfs:comment "relation text exactly as the LLM extracted it"@en .

